rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Teacher grading profiles — only the owner can read/write their own.
    match /gva_profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Grading sessions — owned by the teacher who created them.
    match /gva_sessions/{sessionId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Graded results — owned by the teacher who created them.
    match /gva_results/{resultId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
